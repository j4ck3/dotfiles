# Overrides /usr/share/applications/org.kde.dolphin.desktop.
# Forces dark theme via ~/.local/bin/dolphin.
# No comments inside [Desktop Entry] — elephant parser is strict.

[Desktop Entry]
Type=Application
Version=1.0
Name=Dolphin
GenericName=File Manager
Comment=Browse and manage files
Exec=/home/jacke/.local/bin/dolphin %u
TryExec=/usr/bin/dolphin
Icon=org.kde.dolphin
Terminal=false
StartupNotify=true
StartupWMClass=org.kde.dolphin
Categories=Qt;KDE;System;FileTools;FileManager;
MimeType=inode/directory;
InitialPreference=10
X-DocPath=dolphin/index.html
X-DBUS-ServiceName=org.kde.dolphin
Actions=open-home;open-computer;open-trash;

[Desktop Action open-home]
Name=Home
Exec=/home/jacke/.local/bin/dolphin %u

[Desktop Action open-computer]
Name=Computer
Exec=/home/jacke/.local/bin/dolphin computer:/

[Desktop Action open-trash]
Name=Trash
Exec=/home/jacke/.local/bin/dolphin trash:/
