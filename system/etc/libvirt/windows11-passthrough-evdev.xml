<!--
  Evdev keyboards for passthrough gaming (stable by-id paths).

  Mice + Sound Blaster go via USB hostdev (windows11-passthrough-usb.xml) —
  Finalmouse UltralightX does not work reliably as input-linux/evdev.

  Keyboards:
    - ZSA Voyager (primary; glob matches serial + if02).
      Serial suffix changes on replug — windows11-start re-resolves globs
      before virsh start so QEMU does not die after GPU handoff.
    - Keychron Q1 (both HID keyboard interfaces)

  Merged by: windows11-mode passthrough-evdev
-->
<input type="evdev">
  <source dev="/dev/input/by-id/usb-ZSA_Technology_Labs_Voyager_*-event-kbd" grab="all" repeat="on" grabToggle="shift-shift"/>
</input>
<input type="evdev">
  <source dev="/dev/input/by-id/usb-Keychron_Keychron_Q1-event-kbd" grab="all" repeat="on" grabToggle="shift-shift"/>
</input>
<input type="evdev">
  <source dev="/dev/input/by-id/usb-Keychron_Keychron_Q1-if02-event-kbd" grab="all" repeat="on" grabToggle="shift-shift"/>
</input>
