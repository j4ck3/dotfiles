<!--
  USB devices for passthrough gaming (required when plugged in).

  Only list devices that must be in the guest. Missing vendor/product
  with default startupPolicy aborts virsh start → release hook → ly login.

  startupPolicy=optional: skip quietly if unplugged (still prefer present).
-->
<hostdev mode="subsystem" type="usb" managed="yes">
  <source startupPolicy="optional">
    <vendor id="0x361d"/>
    <product id="0x0100"/>
  </source>
</hostdev>
<hostdev mode="subsystem" type="usb" managed="yes">
  <source startupPolicy="optional">
    <vendor id="0x041e"/>
    <product id="0x324d"/>
  </source>
</hostdev>
