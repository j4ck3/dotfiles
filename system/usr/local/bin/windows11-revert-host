#!/usr/bin/env bash
# Reattach GPU to amdgpu after emergency stop / hard reboot / failed post-VM hook.
set -u

DOMAIN="${DOMAIN:-windows11}"

if [[ "${EUID}" -ne 0 ]]; then
  exec sudo -E DOMAIN="${DOMAIN}" "$0" "$@"
fi

# shellcheck source=/dev/null
source "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../etc/libvirt/windows11" && pwd)/paths.sh"
# shellcheck source=/dev/null
source "${HOOK_LOG_LIB}"
# shellcheck source=/dev/null
source "${GPU_HANDOFF_LIB}"

export DOMAIN GPU_HANDOFF_FORCE=1
RESTORE="${DOTFILES_SYSTEM}/usr/local/bin/windows11-restore-display"
[[ -x "${RESTORE}" ]] || RESTORE="/usr/local/bin/windows11-restore-display"
FAN_RESTORE_SCRIPT="${DOTFILES_ROOT}/hypr/.config/quickshell/scripts/fan-control.sh"

restore_case_fans_auto() {
  [[ -x "${FAN_RESTORE_SCRIPT}" ]] || return 0
  if ! id "${CONSOLE_USER}" >/dev/null 2>&1; then
    return 0
  fi
  local uid home runtime
  uid="$(id -u "${CONSOLE_USER}")"
  home="$(getent passwd "${CONSOLE_USER}" | cut -d: -f6)"
  runtime="/run/user/${uid}"
  [[ -d "${runtime}" ]] || runtime="/tmp"
  echo "STEP: restore case fan auto profile (${CONSOLE_USER})"
  runuser -u "${CONSOLE_USER}" -- env \
    HOME="${home}" \
    XDG_RUNTIME_DIR="${runtime}" \
    "${FAN_RESTORE_SCRIPT}" auto >/dev/null 2>&1 || true
}

# Cancel any in-flight async restore from a prior release hook.
systemctl stop windows11-restore-display.service 2>/dev/null || true
systemctl reset-failed windows11-restore-display.service 2>/dev/null || true

hook_log_begin "windows11-revert-host (manual)" "$@"
hook_log_attach
set -x

echo "STEP: peel vfio (if bound)"
reattach_gpu_to_host

if [[ -x "${RESTORE}" ]]; then
  echo "STEP: sync host GPU restore"
  # restore-display logs itself; run without nested set -x noise if possible
  set +x
  "${RESTORE}"
  restore_rc=$?
  if [[ "${restore_rc}" -ne 0 ]]; then
    echo "WARN: restore-display failed (${restore_rc}); forcing minimal login recovery" >&2
    set -x
    settle_console_input || true
    start_ly_units || true
    safe_chvt 1 || true
  fi
  restore_case_fans_auto
  exit "${restore_rc}"
fi

echo "windows11-restore-display missing; minimal revert..." >&2
virsh nodedev-reattach pci_0000_03_00_1 2>/dev/null || true
virsh nodedev-reattach pci_0000_03_00_0 2>/dev/null || true
modprobe amdgpu 2>/dev/null || true
restore_case_fans_auto
start_ly_units
