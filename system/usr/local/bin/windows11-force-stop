#!/usr/bin/env bash
# Stop windows11 when virsh/libvirt is wedged (VFIO hang). Safe to run over SSH.
set -u

export LC_ALL=C
export LANG=C
export VIRSH_DEFAULT_CONNECT_URI="${CONNECT_URI:-qemu:///system}"

DOMAIN="${DOMAIN:-windows11}"
STOP_TIMEOUT="${STOP_TIMEOUT:-8}"

run_root() {
  if [[ "${EUID}" -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null; then
    sudo -E "$@"
  else
    echo "Need root for: $*" >&2
    return 1
  fi
}

qemu_pids() {
  pgrep -f "guest=${DOMAIN}[, ]" 2>/dev/null || true
}

kill_qemu() {
  local pid
  for pid in $(qemu_pids); do
    echo "Sending SIGTERM to qemu pid ${pid}..."
    kill -TERM "${pid}" 2>/dev/null || run_root kill -TERM "${pid}" 2>/dev/null || true
  done
  sleep 2
  for pid in $(qemu_pids); do
    echo "Sending SIGKILL to qemu pid ${pid}..."
    kill -KILL "${pid}" 2>/dev/null || run_root kill -KILL "${pid}" 2>/dev/null || true
  done
}

kill_stuck_hooks() {
  local pid pat
  for pat in \
    "/hooks/qemu.d/${DOMAIN}/" \
    "virsh .*start ${DOMAIN}" \
    "virsh .*dumpxml ${DOMAIN}"
  do
    for pid in $(pgrep -f "${pat}" 2>/dev/null || true); do
      echo "Killing stuck hook/virsh pid ${pid}..."
      kill -TERM "${pid}" 2>/dev/null || run_root kill -TERM "${pid}" 2>/dev/null || true
    done
  done
  sleep 1
  for pat in \
    "/hooks/qemu.d/${DOMAIN}/" \
    "virsh .*start ${DOMAIN}" \
    "virsh .*dumpxml ${DOMAIN}"
  do
    for pid in $(pgrep -f "${pat}" 2>/dev/null || true); do
      kill -KILL "${pid}" 2>/dev/null || run_root kill -KILL "${pid}" 2>/dev/null || true
    done
  done
}

ensure_host_gpu_restored() {
  local drv hook
  # shellcheck source=/dev/null
  source "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../etc/libvirt/windows11" && pwd)/paths.sh"

  sleep 1
  drv="$(lspci -nnk -s 03:00.0 2>/dev/null | awk '/Kernel driver in use/{print $5}')"
  if [[ "${drv}" == "vfio-pci" ]] || ! pgrep -x Hyprland >/dev/null; then
    if [[ "${drv}" == "vfio-pci" ]]; then
      echo "GPU still on vfio-pci — running revert hook (needs root)..."
    else
      echo "Hyprland not running — running revert hook (needs root)..."
    fi
    if [[ "${DOMAIN}" == "windows11-stealth" ]]; then
      hook="${WINDOWS11_HOOKS_DIR}/qemu.d/windows11-stealth/release/end/revert.sh"
    else
      hook="${WINDOWS11_HOOKS_DIR}/qemu.d/windows11/release/end/revert.sh"
    fi
    if [[ -x "${hook}" ]]; then
      # stdin must NOT be a live TTY feeding the hook's old `cat` — hooks now
      # detect TTY, but still pass empty stdin explicitly.
      run_root env GPU_HANDOFF_FORCE=1 DOMAIN="${DOMAIN}" \
        "${hook}" "${DOMAIN}" release end - </dev/null
    elif [[ "${DOMAIN}" == "windows11-stealth" ]]; then
      run_root /usr/local/bin/windows11-stealth-revert-host
    else
      run_root /usr/local/bin/windows11-revert-host
    fi
  else
    echo "GPU on ${drv:-unknown}, Hyprland up — host display OK."
  fi
}

echo "=== windows11-force-stop (${DOMAIN}) ==="
kill_stuck_hooks

state="$(timeout 5 virsh domstate "${DOMAIN}" 2>/dev/null || true)"
if [[ "${state}" == "shut off" || -z "${state}" ]]; then
  if qemu_pids >/dev/null && [[ -n "$(qemu_pids)" ]]; then
    echo "libvirt says shut off but QEMU still alive — killing..."
    kill_qemu
  else
    echo "${DOMAIN} is already shut off."
  fi
  ensure_host_gpu_restored
  exit 0
fi

echo "Stopping ${DOMAIN} (${state})..."

if timeout "${STOP_TIMEOUT}" virsh destroy "${DOMAIN}" 2>/dev/null; then
  echo "Stopped via virsh destroy."
  ensure_host_gpu_restored
  exit 0
fi

echo "virsh destroy failed or timed out; killing QEMU directly..."
kill_qemu

sleep 1
state="$(timeout 5 virsh domstate "${DOMAIN}" 2>/dev/null || true)"
if [[ "${state}" == "shut off" || -z "${state}" ]]; then
  echo "VM is shut off."
  ensure_host_gpu_restored
  exit 0
fi

echo "VM still reports state: ${state:-unknown}" >&2
echo "If the host display is still broken, run: sudo windows11-stealth-revert-host" >&2
ensure_host_gpu_restored
exit 1
