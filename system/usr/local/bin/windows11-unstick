#!/usr/bin/env bash
# Recover when passthrough left the GPU on vfio and/or a hook is blocking libvirt.
set -u

export LC_ALL=C
export LANG=C
export VIRSH_DEFAULT_CONNECT_URI="${CONNECT_URI:-qemu:///system}"

DOMAIN="${DOMAIN:-windows11}"

run_root() {
  if [[ "${EUID}" -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null; then
    sudo "$@"
  else
    echo "Need root for: $*" >&2
    return 1
  fi
}

echo "=== windows11-unstick (domain=${DOMAIN}) ==="

# Stuck prepare hooks deadlock libvirtd (esp. if hook called virsh dumpxml).
for pat in \
  '/hooks/qemu.d/windows11(-stealth)?/prepare/begin/start.sh' \
  '/hooks/qemu\.d/windows11(-stealth)?/' \
  'virsh .*dumpxml windows11' \
  'virsh .*start windows11'
do
  for pid in $(pgrep -f "${pat}" 2>/dev/null || true); do
    echo "Killing pid ${pid}..."
    kill -TERM "${pid}" 2>/dev/null || run_root kill -TERM "${pid}" 2>/dev/null || true
  done
done
sleep 1
for pat in \
  '/hooks/qemu.d/windows11(-stealth)?/prepare/begin/start.sh' \
  'virsh .*dumpxml windows11' \
  'virsh .*start windows11'
do
  for pid in $(pgrep -f "${pat}" 2>/dev/null || true); do
    kill -KILL "${pid}" 2>/dev/null || run_root kill -KILL "${pid}" 2>/dev/null || true
  done
done

if ! timeout 5 virsh list --all >/dev/null 2>&1; then
  echo "libvirtd still wedged — restarting..."
  run_root systemctl restart libvirtd
  sleep 2
fi

if timeout 5 virsh domstate "${DOMAIN}" 2>/dev/null | grep -q running; then
  echo "Stopping running VM..."
  if [[ -x /usr/local/bin/windows11-force-stop ]]; then
    DOMAIN="${DOMAIN}" /usr/local/bin/windows11-force-stop
  else
    timeout 8 virsh destroy "${DOMAIN}" 2>/dev/null || true
  fi
fi

if [[ "${DOMAIN}" == "windows11-stealth" ]] && [[ -x /usr/local/bin/windows11-stealth-revert-host ]]; then
  echo "Reattaching GPU to host (stealth)..."
  run_root /usr/local/bin/windows11-stealth-revert-host 2>/dev/null || true
elif [[ -x /usr/local/bin/windows11-revert-host ]]; then
  echo "Reattaching GPU to host..."
  run_root /usr/local/bin/windows11-revert-host 2>/dev/null || true
elif [[ "${EUID}" -eq 0 ]]; then
  virsh nodedev-reattach pci_0000_03_00_1 2>/dev/null || true
  virsh nodedev-reattach pci_0000_03_00_0 2>/dev/null || true
  modprobe amdgpu 2>/dev/null || true
fi

echo "Done."
timeout 5 virsh list --all 2>&1 || echo "If still hung: sudo systemctl restart libvirtd"
echo "Hook log:  sudo tail -40 /var/log/windows11-passthrough-hook.log"
echo "Then: DOMAIN=${DOMAIN} windows11-mode status"
