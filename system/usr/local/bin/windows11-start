#!/usr/bin/env bash
# Safe passthrough start — use this instead of bare "virsh start windows11".
set -euo pipefail

export LC_ALL=C
export LANG=C

CONNECT_URI="${CONNECT_URI:-qemu:///system}"
DOMAIN="${DOMAIN:-windows11}"
assume_yes=0

# shellcheck source=/dev/null
source "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../etc/libvirt/windows11" && pwd)/paths.sh"
DOTFILES_LIBVIRT="${DOTFILES_LIBVIRT:-${WINDOWS11_LIBVIRT_ETC}}"

# ZSA Voyager by-id serial changes on replug. QEMU aborts if a baked evdev
# path is missing — after the prepare hook already stole the GPU. Refresh
# live /dev/input/by-id globs BEFORE virsh start.
refresh_evdev_before_start() {
  local xml tmp fragment resolve_py
  fragment="${DOTFILES_LIBVIRT}/windows11-passthrough-evdev.xml"
  resolve_py="${DOTFILES_LIBVIRT}/resolve-evdev.py"
  if ! virsh -c "${CONNECT_URI}" dumpxml "${DOMAIN}" | grep -q "type='evdev'"; then
    return 0
  fi
  if [[ ! -f "${fragment}" || ! -f "${resolve_py}" ]]; then
    echo "WARN: evdev fragment/resolver missing; checking baked paths only." >&2
  fi
  xml="$(mktemp)"
  tmp="$(mktemp)"
  virsh -c "${CONNECT_URI}" dumpxml "${DOMAIN}" > "${xml}"
  local rc=0
  python3 - "${xml}" "${tmp}" "${fragment}" "${resolve_py}" <<'PY' || rc=$?
import os
import sys
import xml.etree.ElementTree as ET

domain_path, out_path, fragment_path, resolve_py = sys.argv[1:5]
tree = ET.parse(domain_path)
devices = tree.getroot().find("devices")
if devices is None:
    sys.exit("no <devices> in domain XML")

changed = False
skipped = []
if os.path.isfile(resolve_py) and os.path.isfile(fragment_path):
    import importlib.util
    spec = importlib.util.spec_from_file_location("resolve_evdev", resolve_py)
    resolve = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(resolve)
    for inp in list(devices.findall("input")):
        if inp.get("type") == "evdev":
            devices.remove(inp)
            changed = True
    merged, skipped = resolve.merge_evdev_inputs(devices, fragment_path)
    changed = changed or merged
else:
    for inp in list(devices.findall("input")):
        if inp.get("type") != "evdev":
            continue
        source = inp.find("source")
        dev = source.get("dev") if source is not None else None
        if not dev or not os.path.exists(dev):
            devices.remove(inp)
            changed = True
            skipped.append(dev or "<missing source>")

remaining = [
    (inp.find("source").get("dev") if inp.find("source") is not None else None)
    for inp in devices.findall("input")
    if inp.get("type") == "evdev"
]
if not remaining:
    print("No live evdev keyboards resolved. Plug Voyager/Keychron, then retry.", file=sys.stderr)
    sys.exit(1)
if skipped:
    print("Skipped missing evdev devices:", file=sys.stderr)
    for dev in skipped:
        print(f"  {dev}", file=sys.stderr)
print("Evdev devices:")
for dev in remaining:
    print(f"  {dev}")
tree.write(out_path, encoding="unicode", xml_declaration=True)
sys.exit(0 if changed else 2)
PY
  if [[ "${rc}" -eq 1 ]]; then
    rm -f "${xml}" "${tmp}"
    echo "Refusing to start: missing evdev would kill QEMU after GPU handoff." >&2
    return 1
  fi
  if [[ "${rc}" -eq 0 ]]; then
    echo "Updating ${DOMAIN} evdev paths (by-id serial changed)."
    if ! virsh -c "${CONNECT_URI}" define "${tmp}"; then
      rm -f "${xml}" "${tmp}"
      echo "virsh define failed while refreshing evdev." >&2
      return 1
    fi
  fi
  rm -f "${xml}" "${tmp}"
}

host_ip() {
  ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1
}

iommu_group_count() {
  find /sys/kernel/iommu_groups -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l
}

require_iommu() {
  local groups cmdline
  groups="$(iommu_group_count)"
  [[ "${groups}" -gt 0 ]] && return 0

  cmdline="$(< /proc/cmdline)"
  echo "IOMMU is inactive: /sys/kernel/iommu_groups is empty." >&2
  echo "Current kernel cmdline has no active IOMMU params:" >&2
  echo "  ${cmdline}" >&2
  echo "Fix, then reboot:" >&2
  if command -v vfio-limine-enable >/dev/null; then
    echo "  sudo vfio-limine-enable --iommu-only" >&2
  elif [[ -x "$HOME/dotfiles/system/usr/local/bin/vfio-limine-enable" ]]; then
    echo "  sudo $HOME/dotfiles/system/usr/local/bin/vfio-limine-enable --iommu-only" >&2
  else
    echo "  add intel_iommu=on iommu=pt to /etc/default/limine, run sudo limine-update, reboot" >&2
  fi
  exit 1
}

require_vfio_available() {
  [[ -d /sys/bus/pci/drivers/vfio-pci ]] && return 0
  if command -v modprobe >/dev/null && modprobe -n -v vfio-pci >/dev/null 2>&1; then
    return 0
  fi
  echo "vfio-pci is unavailable for running kernel $(uname -r)." >&2
  echo "Reboot into a kernel with matching /lib/modules, then retry." >&2
  exit 1
}

usage() {
  cat <<EOF
Usage: ${0##*/} [--yes]

Starts ${DOMAIN} in GPU passthrough mode.

IMPORTANT — single monitor on the AMD GPU:
  When the VM runs, Linux has NO picture on that screen. Ctrl+Alt+F3 will NOT
  help you see a rescue TTY (same physical outputs as the VM).

  Before starting, use ONE of:
    • SSH from phone/laptop:  ssh YOU@HOST 'windows11-force-stop'
    • Second monitor on Intel motherboard HDMI (host rescue screen)

Options:
  --yes, -y             Start without confirmation prompt

If Windows appears: shut down from Start menu (do not hard power-off the PC).
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes|-y) assume_yes=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ ! -e /etc/libvirt/hooks/windows11-gpu-passthrough.enabled ]]; then
  echo "Passthrough hook is disabled. Run: sudo windows11-mode passthrough" >&2
  exit 1
fi

state="$(virsh -c "${CONNECT_URI}" domstate "${DOMAIN}" 2>/dev/null || true)"
if [[ "${state}" == "running" ]]; then
  echo "${DOMAIN} is already running."
  exit 0
fi

if ! [[ -f /var/lib/libvirt/vbios/rx7900xtx.rom ]]; then
  echo "Missing VBIOS. Run: sudo windows11-dump-vbios" >&2
  exit 1
fi
if ! virsh -c "${CONNECT_URI}" dumpxml "${DOMAIN}" | grep -q 'rx7900xtx\.rom'; then
  echo "GPU VBIOS ROM not in domain XML. Run: sudo windows11-mode passthrough" >&2
  exit 1
fi
require_vfio_available
require_iommu
refresh_evdev_before_start

ip_addr="$(host_ip || true)"
user="$(id -un)"

cat <<EOF

=== Passthrough start checklist ===
  Monitor:     cable on RX 7900 only (Intel/iGPU will stay black — not Windows)
  BIOS:        IOMMU/VT-d + Above 4G on
  Recovery:    ssh ${user}@${ip_addr:-YOUR_HOST_IP} 'DOMAIN=${DOMAIN} windows11-force-stop'
                 (if display broken) ssh ${user}@${ip_addr:-YOUR_HOST_IP} 'sudo DOMAIN=${DOMAIN} windows11-revert-host'
EOF

if systemctl is-active --quiet sshd 2>/dev/null; then
  echo "  SSH:         active"
else
  echo "  SSH:         NOT RUNNING — enable sshd before passthrough!" >&2
fi

if [[ "${assume_yes}" -eq 0 ]]; then
  echo ""
  if ! [[ -t 0 ]]; then
    echo "Not a TTY — use: ${0##*/} --yes" >&2
    exit 1
  fi
  read -r -p "Start ${DOMAIN} now? [y/N] " ans
  if [[ "${ans,,}" != "y" && "${ans,,}" != "yes" ]]; then
    echo "Cancelled (no changes). Use --yes to skip this prompt."
    exit 0
  fi
fi

# Prepare hook kills Hyprland. If this script runs inside that session, SIGHUP
# aborts virsh start mid-flight and leaves the GPU on vfio. Detach first.
start_log="${XDG_RUNTIME_DIR:-/tmp}/windows11-${DOMAIN}-start.log"
if [[ "${WINDOWS11_START_DETACHED:-0}" != "1" ]] \
  && { [[ -n "${WAYLAND_DISPLAY:-}" ]] || [[ -n "${DISPLAY:-}" ]]; }; then
  echo ""
  echo "Graphical session detected — prepare hook will kill Hyprland."
  echo "Detaching start to background so a dying terminal cannot abort it."
  echo "  Log:      ${start_log}"
  if [[ "${DOMAIN}" == "windows11-stealth" ]]; then
    echo "  Recovery: ssh ${user}@${ip_addr:-HOST} windows11-stealth-force-stop"
  else
    echo "  Recovery: ssh ${user}@${ip_addr:-HOST} windows11-force-stop"
  fi
  : > "${start_log}"
  # Pass DOMAIN explicitly. Brief sleep so setsid -f can leave the terminal's
  # process group before ghostty/xdg-terminal-exec tears the PTY down (race
  # otherwise leaves an empty log and never starts the VM).
  nohup setsid -f env WINDOWS11_START_DETACHED=1 DOMAIN="${DOMAIN}" \
    "$(readlink -f "$0")" --yes </dev/null >>"${start_log}" 2>&1 &
  echo "Background pid $!. Watch: tail -f ${start_log}"
  sleep 0.15
  exit 0
fi

echo ""
echo "Starting ${DOMAIN}..."
if ! virsh -c "${CONNECT_URI}" start "${DOMAIN}"; then
  echo "virsh start failed — restoring host GPU/display..." >&2
  if [[ "${DOMAIN}" == "windows11-stealth" ]] && [[ -x /usr/local/bin/windows11-stealth-force-stop ]]; then
    /usr/local/bin/windows11-stealth-force-stop || true
  elif [[ -x /usr/local/bin/windows11-force-stop ]]; then
    DOMAIN="${DOMAIN}" /usr/local/bin/windows11-force-stop || true
  fi
  exit 1
fi
echo "Started. Windows appears ONLY on the RX 7900 port (not motherboard HDMI)."
echo "Kernel text on Intel/iGPU during revert is normal (amdgpu overdrive notice)."
echo "Black on AMD? Run: windows11-passthrough-doctor"
echo "If still black after 2 min, recover via SSH (see checklist above)."
