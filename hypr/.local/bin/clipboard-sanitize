#!/usr/bin/env python3
"""Rewrite Wayland clipboard text as plain text with URLs removed."""

from __future__ import annotations

from html.parser import HTMLParser
import os
import re
import subprocess
import sys

BLOCK_TAGS = {"br", "div", "p", "li", "tr", "h1", "h2", "h3", "h4", "h5", "h6"}


class PlainTextParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.parts: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag in BLOCK_TAGS and self.parts:
            self.parts.append("\n")

    def handle_endtag(self, tag: str) -> None:
        if tag in BLOCK_TAGS:
            self.parts.append("\n")

    def handle_data(self, data: str) -> None:
        self.parts.append(data)


def plain_text(text: str) -> str:
    if not re.search(r"</?[a-zA-Z][^>]*>", text):
        return text
    parser = PlainTextParser()
    parser.feed(text)
    return re.sub(r"\n{3,}", "\n\n", "".join(parser.parts)).strip()


def sanitize(text: str) -> str:
    return plain_text(text)


def main() -> int:
    if os.environ.get("CLIPBOARD_STATE") != "data":
        return 0

    original = sys.stdin.buffer.read().decode("utf-8", errors="replace")
    sanitized = sanitize(original)

    # Avoid replacing already-sanitized plain text. This prevents a self-trigger loop
    # while preserving normal clipboard ownership for ordinary copies.
    if sanitized == original:
        return 0

    subprocess.run(
        ["wl-copy", "--type", "text/plain;charset=utf-8"],
        input=sanitized.encode(),
        check=True,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
