# Home Assistant connection for Quickshell PowerMenu light control.
# Token lives outside the repo: create a long-lived access token in HA
# (Profile → Security), then:
#   mkdir -p ~/.config/homeassistant
#   printf '%s\n' 'YOUR_TOKEN' > ~/.config/homeassistant/token
#   chmod 600 ~/.config/homeassistant/token

HA_URL=http://10.0.0.23:8123
HA_ENTITY=light.floor_light
HA_TOKEN_FILE=${HOME}/.config/homeassistant/token
