[Unit]
Description=Quickshell desktop shell
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/hypr/scripts/quickshell-start
Restart=on-failure
RestartSec=1
# Apps opened from Quickshell inherit this cgroup. Restart only shell process,
# otherwise systemd also kills children such as Helium.
KillMode=process

[Install]
WantedBy=graphical-session.target
