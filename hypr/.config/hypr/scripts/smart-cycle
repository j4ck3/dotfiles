#!/usr/bin/env bash
# Smart ALT+TAB: cycle group tabs when in a group, otherwise cycle windows normally.
# Usage: smart-cycle [prev]

ACTIVE_JSON=$(hyprctl activewindow -j 2>/dev/null) || exit 0
ACTIVE_ADDR=$(jq -r '.address // empty' <<<"$ACTIVE_JSON")
WS_ID=$(jq -r '.workspace.id // empty' <<<"$ACTIVE_JSON")
[[ -z "$ACTIVE_ADDR" || -z "$WS_ID" ]] && exit 0

mapfile -t WINDOWS < <(
    hyprctl clients -j 2>/dev/null |
        jq -r --argjson ws "$WS_ID" \
            '[.[] | select(.workspace.id == $ws and .mapped == true)] | sort_by(.address) | .[].address'
)

COUNT=${#WINDOWS[@]}
(( COUNT <= 1 )) && exit 0

ACTIVE_INDEX=0
for i in "${!WINDOWS[@]}"; do
    if [[ "${WINDOWS[$i]}" == "$ACTIVE_ADDR" ]]; then
        ACTIVE_INDEX=$i
        break
    fi
done

if [[ "${1:-}" == "prev" ]]; then
    TARGET_INDEX=$(( (ACTIVE_INDEX - 1 + COUNT) % COUNT ))
else
    TARGET_INDEX=$(( (ACTIVE_INDEX + 1) % COUNT ))
fi

hyprctl dispatch "hl.dsp.focus({ window = \"address:${WINDOWS[$TARGET_INDEX]}\" })"
