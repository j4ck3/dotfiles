#!/bin/bash
# Switch to workspace and launch app if not already there
# Usage: webapp-launch <workspace> <app_class> <launch_command...>

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/16-9-lib.sh"

WORKSPACE="$1"
APP_CLASS="$2"
shift 2

find_window() {
    hyprctl clients -j | jq -r --argjson workspace "$WORKSPACE" --arg class "$APP_CLASS" \
        '[.[] | select(.workspace.id == $workspace and (.class | ascii_downcase) == ($class | ascii_downcase))] | last.address // empty'
}

ACTIVE_WORKSPACE=$(hyprctl monitors -j 2>/dev/null | jq -r '
	.[] | select(.focused == true) | .activeWorkspace.id
')
ADDRESS=$(find_window)

if [[ "$ACTIVE_WORKSPACE" == "$WORKSPACE" && -n "$ADDRESS" ]]; then
	exec "$SCRIPT_DIR/smart-cycle"
fi

hyprctl dispatch "hl.dsp.focus({ workspace = $WORKSPACE, on_current_monitor = true })"

if [ -z "$ADDRESS" ]; then
    "$@" &

    for _ in $(seq 1 80); do
        sleep 0.25
        ADDRESS=$(find_window)
        [ -n "$ADDRESS" ] && break
    done
fi

if [ -n "$ADDRESS" ]; then
    sixteen_nine_apply_to_address "$ADDRESS"
fi
