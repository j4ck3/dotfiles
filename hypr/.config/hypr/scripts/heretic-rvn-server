#!/usr/bin/env bash
# Start llama-server for RVN Qwen3.8-27B (Heretic Abliterated, MTP head embedded).
set -euo pipefail

readonly ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/heretic-rvn"
readonly LLAMA_DIR="${HERETIC_LLAMA_DIR:-$HOME/.local/share/s1-mini/llama/llama-b10661}"
readonly MODEL="${HERETIC_MODEL:-$ROOT/RVN-Q4_K_M-multilingual-mtp.gguf}"
readonly HOST="${HERETIC_HOST:-0.0.0.0}"
readonly PORT="${HERETIC_PORT:-8080}"
readonly CTX="${HERETIC_CTX:-32768}"
readonly DRAFT_MAX="${HERETIC_DRAFT_N_MAX:-3}"
readonly BIN="${HERETIC_SERVER_BIN:-$HOME/.local/bin/llama-server}"

[[ -f "$MODEL" ]] || { echo "missing model: $MODEL" >&2; exit 1; }
[[ -x "$BIN" || -L "$BIN" ]] || { echo "missing llama-server: $BIN" >&2; exit 1; }

export LD_LIBRARY_PATH="${LLAMA_DIR}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec "$BIN" \
  -m "$MODEL" \
  --host "$HOST" \
  --port "$PORT" \
  --jinja \
  -ngl 99 \
  -c "$CTX" \
  --spec-type draft-mtp \
  --spec-draft-n-max "$DRAFT_MAX" \
  --parallel 1 \
  "$@"
