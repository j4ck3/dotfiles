#!/usr/bin/env bash
# Apply 16:9 floating group on current workspace (one-way; no toggle-off).
# Already floating → re-snap centered 16:9 (fixes dragged-away windows).
# Groups handle cycling (changegroupactive), popups stay on top, groupbar is hidden.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=16-9-lib.sh
source "$SCRIPT_DIR/16-9-lib.sh"

ACTIVE_JSON=$(hyprctl activewindow -j 2>/dev/null) || exit 0
[[ -z "$ACTIVE_JSON" || "$ACTIVE_JSON" == "{}" || "$ACTIVE_JSON" == "null" ]] && exit 0

ACTIVE_ADDR=$(jq -r '.address' <<< "$ACTIVE_JSON")
WS_ID=$(jq -r '.workspace.id' <<< "$ACTIVE_JSON")
MON_ID=$(jq -r '.monitor' <<< "$ACTIVE_JSON")
ACTIVE_FLOATING=$(jq -r '.floating' <<< "$ACTIVE_JSON")
GROUPED_LEN=$(jq -r '.grouped | length' <<< "$ACTIVE_JSON")

sixteen_nine_geometry "$MON_ID" || exit 0

# Already floating (moved / off-center): re-snap size+position only.
# float action=set toggles — sixteen_nine_float_resize skips it when already floating.
if [[ "$ACTIVE_FLOATING" == "true" ]]; then
	# Ensure a group so Alt+Tab / stack behavior stays consistent.
	if [[ "$GROUPED_LEN" -le 0 ]]; then
		hyprctl dispatch "hl.dsp.window.float({ action = \"unset\", window = \"address:$ACTIVE_ADDR\" })"
		hyprctl dispatch "hl.dsp.group.toggle({ window = \"address:$ACTIVE_ADDR\" })"
	fi
	sixteen_nine_float_resize "$ACTIVE_ADDR"
	sixteen_nine_enable_workspace "$WS_ID"
	exit 0
fi

# Enter: create group while tiled, then float at 16:9
ALL_ADDRS=$(hyprctl clients -j 2>/dev/null \
	| jq -r --argjson ws "$WS_ID" '[.[] | select(.workspace.id == $ws and .mapped == true and .floating == false)] | .[].address')

COUNT=$(echo "$ALL_ADDRS" | grep -c .)
[[ "$COUNT" -le 0 ]] && exit 0

# Step 1: Build group while windows are tiled (so direction-based moveintogroup works)
hyprctl dispatch "hl.dsp.group.toggle({ window = \"address:$ACTIVE_ADDR\" })"
if [[ "$COUNT" -gt 1 ]]; then
	for addr in $ALL_ADDRS; do
		[[ "$addr" == "$ACTIVE_ADDR" ]] && continue
		hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })"
		for direction in left right up down; do
			hyprctl dispatch "hl.dsp.window.move({ into_group = \"$direction\", window = \"address:$addr\" })" >/dev/null 2>&1 || true
		done
	done
	hyprctl dispatch "hl.dsp.focus({ window = \"address:$ACTIVE_ADDR\" })"
fi

# Step 2: Float the group and resize to 16:9
sixteen_nine_float_resize "$ACTIVE_ADDR"
sixteen_nine_enable_workspace "$WS_ID"
