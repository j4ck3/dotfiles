#!/bin/bash
# spotify-volume-guard: Prevents Spotify from resetting volume to 100% on new tracks
# Spotify on Linux resets its PipeWire/PulseAudio stream volume to 100% every time
# a new track starts. This daemon monitors sink-input events and reverts the reset.
#
# Coordinates with spotify-volume / volume-popup-control via a shared state file.
# State is ONLY written by those user-facing tools — never learned from transient
# stream blips (seek / pause / play), which used to corrupt the saved volume.

STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/spotify-volume-state"
MIN_SAVED_VOLUME=5  # avoid pinning stream at 0% after F11 spam

spotify_json() {
    pactl --format=json list sink-inputs 2>/dev/null | jq -c '
      def is_spotify:
        ((.properties["application.name"] // "") | ascii_downcase) == "spotify"
        or ((.properties["media.name"] // "") | ascii_downcase) == "spotify"
        or ((.properties["application.process.binary"] // "") | ascii_downcase | test("spotify"));
      def pct:
        (.volume // {})
        | [to_entries[] | .value.value_percent? // empty | sub("%$"; "") | tonumber]
        | if length == 0 then empty else ((add / length) | round) end;
      [.[] | select(is_spotify) | {id: .index, vol: pct}] | .[0] // empty
    '
}

read_spotify() {
    local raw
    raw=$(spotify_json)
    [[ -z "$raw" || "$raw" == "null" ]] && return 1
    SPOTIFY_ID=$(jq -r '.id' <<<"$raw")
    SPOTIFY_VOL=$(jq -r '.vol' <<<"$raw")
    [[ -n "$SPOTIFY_ID" && "$SPOTIFY_ID" != "null" && -n "$SPOTIFY_VOL" && "$SPOTIFY_VOL" != "null" ]]
}

# Seed the state file from current Spotify volume if it doesn't exist
if [[ ! -f "$STATE_FILE" ]]; then
    if read_spotify; then
        echo "$SPOTIFY_VOL" > "$STATE_FILE"
    fi
fi

pactl subscribe 2>/dev/null | grep --line-buffered "sink-input" | while read -r _; do
    read_spotify || continue

    saved_vol=""
    [[ -f "$STATE_FILE" ]] && saved_vol=$(tr -d '[:space:]' <"$STATE_FILE")

    if [[ -z "$saved_vol" ]]; then
        echo "$SPOTIFY_VOL" > "$STATE_FILE"
        continue
    fi

    if (( saved_vol < MIN_SAVED_VOLUME )); then
        saved_vol=$MIN_SAVED_VOLUME
    fi

    # Only act on Spotify's notorious >=100% reset. Do not rewrite state from
    # observed volume — seek/pause causes false readings that poisoned volume.
    if (( SPOTIFY_VOL >= 100 && saved_vol < SPOTIFY_VOL )); then
        pactl set-sink-input-volume "$SPOTIFY_ID" "${saved_vol}%"
        # Keep MPRIS aligned so the next seek does not push a stale MPRIS level.
        frac=$(awk -v p="$saved_vol" 'BEGIN { printf "%.4f", p / 100 }')
        playerctl -p spotify volume "$frac" >/dev/null 2>&1 || true
    fi
done
